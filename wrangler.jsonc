{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wanhsiyuan-site",
  "account_id": "08e168998c08eeef0e52dcf2c7afdefc",
  "compatibility_date": "2026-09-17",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "wanhsiyuan.com/*",
      "zone_name": "wanhsiyuan.com"
    },
    {
      "pattern": "www.wanhsiyuan.com/*",
      "zone_name": "wanhsiyuan.com"
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
